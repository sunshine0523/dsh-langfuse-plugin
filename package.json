{
  "name": "dsh-langfuse-plugin",
  "version": "0.1.1",
  "description": "Langfuse tracing plugin for DeepSeek Harness (DSH).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshine0523/dsh-langfuse-plugin.git"
  },
  "homepage": "https://github.com/sunshine0523/dsh-langfuse-plugin#readme",
  "bugs": {
    "url": "https://github.com/sunshine0523/dsh-langfuse-plugin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "langfuse",
    "opentelemetry",
    "observability"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1"
  }
}
